NODE_ENV=development
PORT=3100

# Where the gateway reads the services from: a registry bucket name in a
# deployed service, or a directory locally (./.registry-local by default in
# development; `make registry.local` fills it from a local core).
REGISTRY=./.registry-local

# Root fields that run without a session or a Turnstile check, comma-separated.
WHITE_LIST_OPERATION=i18nTranslations

# The sessions collection, shared with core. Locally, core's database.
MONGODB_ATLAS_URI=
MONGODB_DATABASE=dev

# Signs anonymous access tokens and verifies every access token. The same key core signs with.
JWT_SIGNING_KEY=

# Cloudflare Turnstile. Unset outside production lets every new session through.
# Test secrets: 1x0000000000000000000000000000000AA passes, 2x0000000000000000000000000000000AA fails.
# TURNSTILE_SECRET_KEY=
# Hostnames the widget may run on, comma-separated. Unset accepts any.
# TURNSTILE_HOSTNAMES=ki-cl.com,www.ki-cl.com
